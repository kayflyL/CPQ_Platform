		{"id":"64f26ee2d45f3499","type":"text","text":"# 配件参数维护\n1. 性能参数\n2. 品牌\n3. 适用机型\n有了这些信息，可以服务于服务器选配功能\n","x":1765,"y":1445,"width":240,"height":229,"color":"4"},
		{"id":"229b4e78cad1f894","type":"text","text":"# 记录历史价格\n异常价格，一眼发现","x":2045,"y":1445,"width":240,"height":229,"color":"4"},
