{
  "version": 1,
  "requirement_analysis": {
    "input": {
      "description": "接收客户自然语言需求与商机上下文",
      "deterministic": true
    },
    "agent_fill": {
      "description": "会对话、会查目录确认在售/系列、边答边填线索登记表；信息不足自然反问，一个回合可批量填多个槽；机型与配件的最终选型交给下游节点",
      "rule_types": ["platform_series_map", "category_alias", "workload_map", "compliance_map"],
      "enabled_tools": ["list_server_types", "list_server_models", "get_server_model"]
    },
    "model_reason": {
      "description": "按线索登记字段推荐或智能选配在售机型骨架",
      "rule_types": ["fallback_order", "compliance_map"],
      "enabled_tools": ["select_models"],
      "series_limit": 3,
      "detail_link_enabled": true,
      "intro_length": "medium",
      "sort_by": "match_stage"
    },
    "kp_reason": {
      "description": "按线索登记字段选择关键配件",
      "enabled_tools": ["pick_kp_parts"],
      "confirm_mode": "auto",
      "reason_template": "配件规划：已确认 {{items}}",
      "representative_pick": "auto",
      "fallback_strategy": "fallback_representative",
      "drive_spec_substitute": true,
      "rule_types": ["type_package", "category_alias", "spec_rule", "cpu_mem_generation", "capacity_match", "raid_level_map", "compliance_map"]
    },
    "compose": {
      "description": "按真实 BOM 模板组装 bom_scheme.configs",
      "kp_source": "per_baseline",
      "psu_override_enabled": true,
      "psu_wattage_source": "ext.psu_signal.wattage",
      "psu_qty_source": "ext.psu_signal.qty",
      "deterministic": true
    },
    "output": {
      "description": "写回真实 requirement + bom_scheme，并交付给 AI Office/商机详情页",
      "output_kind": "bom_scheme_draft",
      "target": "bom_scheme",
      "payload_map": { "plans": "ctx.plans", "ext": "ctx.ext" },
      "actions": [],
      "deterministic": true
    }
  }
}
